<section class="hero">
  <h1>Welcome to Anthony Esports Blog</h1>
  <p>Your source for the latest in collegiate esports</p>
</section>
<section class="posts">
  <h2>Latest Posts</h2>
  <a href="/create" class="create-btn btn-grad">Create New Post</a>
  <% if (posts.length === 0) { %>
  <p>No posts yet. Be the first to create one!</p>
  <% } else { %>
  <div class="posts-grid">
    <% posts.forEach(post => { %>
    <article class="post-card">
      <% if (post.image) { %>
      <img src="<%= post.image %>" alt="<%= post.title %>" loading="lazy" />
      <% } %>
      <div class="post-content">
        <h3><%= post.title %></h3>
        <p><%= post.summary || post.content.substring(0, 100) %></p>
      </div>
      <div class="post-actions">
        <a href="/edit/<%= post.id %>" class="action-btn">Edit</a>
        <form action="/delete/<%= post.id %>" method="POST">
          <button type="submit" class="action-btn">Delete</button>
        </form>
      </div>
    </article>
    <% }) %>
  </div>
  <% } %>
</section>
