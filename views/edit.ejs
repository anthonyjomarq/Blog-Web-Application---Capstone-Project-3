<section class="posts">
  <h2>Edit Post</h2>
  <% if (typeof error !== 'undefined') { %>
  <p style="color: red"><%= error %></p>
  <% } %>
  <form action="/edit/<%= post.id %>" method="POST">
    <label for="title">Title:</label>
    <input
      type="text"
      id="title"
      name="title"
      value="<%= formData?.title || post.title %>"
      required
    />
    <label for="content">Content:</label>
    <textarea id="content" name="content" required>
<%= formData?.content || post.content %></textarea
    >
    <button type="submit" class="create-btn btn-grad">Update</button>
  </form>
  <a href="/" class="create-btn btn-grad" style="margin-top: 20px"
    >Back to Home</a
  >
</section>
